# READORA — PostgreSQL & Production Configuration
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"
POSTGRES_URL="postgres://user:password@host:5432/postgres?sslmode=require"
PRISMA_DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Session & Authentication Secret (Generate a 32+ character random string for production)
AUTH_SECRET="readora-super-secret-key-production-safe-32chars"
PORT=3000

# Optional: Razorpay Payment Gateway (or configure in Admin UI)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional: SMTP Email Settings (or configure in Admin UI)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="library@readora.library"
SMTP_FROM_NAME="READORA Digital Library"
ADMIN_ALERT_EMAIL="admin@readora.library"
