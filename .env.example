# ==============================================================================
# 💻 1. LOCAL DEVELOPMENT DATABASE (SQLite)
# ==============================================================================
DATABASE_URL="file:./dev.db"

# ==============================================================================
# ⚡ 2. VERCEL PRODUCTION DATABASE (PostgreSQL)
# ==============================================================================
POSTGRES_URL="postgres://user:password@host:5432/postgres?sslmode=require"
PRISMA_DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"
VERCEL_DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# ==============================================================================
# 🔐 3. AUTHENTICATION & SECRETS
# ==============================================================================
AUTH_SECRET="readora-super-secret-key-production-safe-32chars"
PORT=3000

# Optional: Razorpay Payment Gateway (or configure in Admin UI)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional: SMTP Email Settings (or configure in Admin UI)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Readora Library <library@readora.app>"
